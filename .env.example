# Copier en .env et adapter. Ne jamais committer .env.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour le CSRF derrière un proxy HTTPS, ex. https://recettes.example.fr
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 en production derrière un proxy HTTPS (redirection, cookies sécurisés, HSTS) ; 0 pour tester en local
DJANGO_HTTPS=0
# 1 = Django sert les photos (petite installation)
DJANGO_SERVE_MEDIA=1

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=recettes
POSTGRES_USER=recettes
POSTGRES_PASSWORD=recettes

# Hors Docker : base utilisée par Django (SQLite si absent)
# DATABASE_URL=postgres://recettes:recettes@localhost:5432/recettes
