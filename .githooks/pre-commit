#!/usr/bin/env bash
# 1. Refuse les commits directs sur main (voir docs/developpement.md, « Branches et versions »).
# 2. Lance la suite de tests complète et bloque le commit si elle échoue.
#    L'historique des passages est ajouté au commit.
# Activation (une fois par clone) : git config core.hooksPath .githooks  (fait par make install)
ROOT="$(git rev-parse --show-toplevel)"

BRANCH="$(git symbolic-ref --short -q HEAD)"
if [ "$BRANCH" = "main" ]; then
  echo "✋ Commit refusé : on ne committe pas directement sur main."
  echo "   Créer une branche : git switch dev && git switch -c feature/<sujet>"
  echo "   (correctif urgent : git switch -c hotfix/<sujet> depuis main)"
  exit 1
fi

"$ROOT/scripts/check.sh"
STATUS=$?
git -C "$ROOT" add test-reports/HISTORIQUE.md
exit $STATUS
